<?xml version="1.0" encoding="UTF-8"?>

<manifest>
    <!-- Experimental LineageOS 19.1 manifest. Upstream no longer declares
         APQ8084 projects, so add them instead of removing absent projects. -->

    <!-- Owned copies include the pinned Quark media/display backports. -->
    <project path="hardware/qcom-caf/apq8084/media" name="lucasgsq/android_hardware_qcom_media" remote="github" revision="A12+" groups="qcom,pdk-qcom" />
    <project path="hardware/qcom-caf/apq8084/display" name="lucasgsq/android_hardware_qcom_display" remote="github" revision="A12+" groups="pdk-qcom,qcom,qcom_display" />

    <!--Device Trees-->
    <project path="device/motorola/quark" name="lucasgsq/device_motorola_quark" remote="github" revision="A12+">
        <linkfile src="configs/apq8084-Android.mk" dest="hardware/qcom-caf/apq8084/Android.mk" />
    </project>

    <!--Kernel-->
    <project path="kernel/motorola/apq8084" name="lucasgsq/kernel_motorola_apq8084" remote="github" revision="A12+" />

    <!-- Legacy source baselines: availability verified, Android 12 build/API
         compatibility remains to be validated. -->
    <project path="hardware/qcom-caf/apq8084/audio" name="LineageOS/android_hardware_qcom_audio" remote="github" revision="lineage-18.1-caf-apq8084" />

    <!-- Qualcomm SoftAP SDK required by libqsapshim -->
    <project name="LineageOS/android_system_qcom" path="system/qcom" remote="github" revision="lineage-19.1" />

    <!-- Vendor folders -->
    <project path="vendor/motorola" name="lucasgsq/proprietary_vendor_motorola" remote="github" revision="A12+" />
	
    <!-- timekeep service-->
	<project name="LineageOS/android_hardware_sony_timekeep" path="hardware/sony/timekeep" remote="github" revision="lineage-19.1" />
    

    <!-- Matching SELinux forks: source corrections through validated stage 35. -->
    <remove-project name="LineageOS/android_device_qcom_sepolicy" path="device/qcom/sepolicy-legacy" optional="true" />
    <project name="lucasgsq/android_device_qcom_sepolicy" path="device/qcom/sepolicy-legacy" remote="github" revision="A12+" groups="qcom,pdk-qcom" />
    <remove-project name="LineageOS/android_system_sepolicy" path="system/sepolicy" optional="true" />
    <project name="lucasgsq/android_system_sepolicy" path="system/sepolicy" remote="github" revision="A12+" groups="pdk" />
    <remove-project name="LineageOS/android_device_lineage_sepolicy" path="device/lineage/sepolicy" optional="true" />
    <project name="lucasgsq/android_device_lineage_sepolicy" path="device/lineage/sepolicy" remote="github" revision="A12+" />

</manifest>
